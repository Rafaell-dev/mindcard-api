            }
          ]
        },
        {
          "name": "Login com Google",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google"]
            },
            "description": "Inicia o fluxo de autenticação OAuth com Google.\n\n**Comportamento:**\nRedireciona o usuário para a página de login do Google.\n\n**⚠️ Nota:** Este endpoint deve ser acessado diretamente no navegador, não via Postman.\n\n**Resposta:** 302 Redirect para Google OAuth"
          },
          "response": []
        },
        {
          "name": "Callback Google OAuth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google/callback",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google", "callback"]
            },
            "description": "Callback que recebe a resposta do Google OAuth.\n\n**⚠️ Nota:** Este endpoint é chamado automaticamente pelo Google após a autenticação.\n\n**Comportamento:**\nRedireciona para o frontend com o token JWT na query string:\n`{FRONTEND_URL}?token={accessToken}`\n\n**Resposta:** 302 Redirect com token"
          },
          "response": []
        },
        {
          "name": "Obter Perfil do Usuário",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/perfil",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "perfil"]
            },
            "description": "Retorna os dados do usuário autenticado via token JWT.\n\n**Autenticação:** Bearer Token (JWT)\n\n**Resposta de sucesso:** 200\n```json\n{\n  \"id\": \"01JCQR...\",\n  \"email\": \"usuario@email.com\",\n  \"nome\": \"Nome do Usuário\"\n}\n```\n\n**Erro:** 401 - Token inválido ou expirado"
          },
          "response": []
        }
      ],
      "description": "Endpoints de autenticação da API MindCard.\n\nSuporta login tradicional com email/senha e OAuth com Google.\n\n**Token JWT:**\nApós login bem-sucedido, um token JWT é retornado e deve ser incluído no header `Authorization: Bearer {token}` para acessar endpoints protegidos."
    },
