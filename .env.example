# Application
NODE_ENV=production
LOG_LEVEL=info
ENABLE_HTTP_LOGGING=true
MASK_SENSITIVE_DATA=true
HOST=0.0.0.0
PORT=3002

# Database
DATABASE_URL=postgresql://postgres:sua_senha@postgres:5432/mindcard?schema=public
DATABASE_USER=postgres
DATABASE_PASSWORD=sua_senha_forte_aqui
DATABASE_NAME=mindcard
POSTGRES_PORT=5436

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue
QUEUE_CONCURRENCY=3
QUEUE_MAX_RETRIES=3
QUEUE_TIMEOUT=300000

# Cloudflare R2
R2_ENDPOINT=https://seu-endpoint.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=sua_access_key
R2_SECRET_ACCESS_KEY=sua_secret_key
R2_BUCKET_NAME=seu-bucket

# Gemini AI
GEMINI_API_KEY=sua_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40
GEMINI_ENABLE_CACHE=true
GEMINI_CACHE_TTL=3600
GEMINI_ENABLE_RATE_LIMIT=true
GEMINI_REQUESTS_PER_MINUTE=60
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY=1000

# Google OAuth
GOOGLE_CLIENT_ID=seu_client_id
GOOGLE_CLIENT_SECRET=seu_client_secret

# JWT
JWT_SECRET=gere_uma_chave_segura_aqui
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=https://seu-dominio.com/auth/callback
